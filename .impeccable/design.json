      "css": ".ds-fighter{background:var(--color-bg-raised,#0a1016);color:var(--color-text,#edf7fb);border:1px solid var(--color-border-strong,#365065);font-family:var(--font-ui,system-ui,sans-serif);cursor:pointer;transition:border-color var(--motion-fast,120ms),color var(--motion-fast,120ms),box-shadow var(--motion-fast,120ms),transform var(--motion-fast,120ms);min-height:68px;padding:var(--space-2,8px);color:var(--color-cyan,#25d9f8);border-color:var(--color-cyan,#25d9f8)}.ds-fighter:hover{color:var(--color-text,#edf7fb);border-color:var(--color-text-muted,#8da4b4)}.ds-fighter:focus-visible{outline:none;box-shadow:var(--focus-ring,0 0 0 2px #05080c,0 0 0 4px #25d9f8)}.ds-fighter:active{transform:translateY(1px)}.ds-fighter:disabled{opacity:.42;cursor:not-allowed;box-shadow:none}"
