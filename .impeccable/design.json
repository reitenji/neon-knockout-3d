      "html": "<button class=\"ds-chrome\">Kopyala</button>",
      "css": ".ds-chrome{background:var(--color-bg-raised,#0a1016);color:var(--color-text,#edf7fb);border:1px solid var(--color-border-strong,#365065);font-family:var(--font-ui,system-ui,sans-serif);cursor:pointer;transition:border-color var(--motion-fast,120ms),color var(--motion-fast,120ms),box-shadow var(--motion-fast,120ms),transform var(--motion-fast,120ms);min-height:34px;padding:0 11px;border-radius:var(--radius-sm,4px);color:var(--color-text-muted,#8da4b4);font-size:.72rem;letter-spacing:.05em}.ds-chrome:hover{color:var(--color-text,#edf7fb);border-color:var(--color-text-muted,#8da4b4)}.ds-chrome:focus-visible{outline:none;box-shadow:var(--focus-ring,0 0 0 2px #05080c,0 0 0 4px #25d9f8)}.ds-chrome:active{transform:translateY(1px)}.ds-chrome:disabled{opacity:.42;cursor:not-allowed}"
    },
    {
      "name": "Cyan input",
      "kind": "input",
      "refersTo": "input",
      "description": "Labeled room-entry field with focus and invalid state.",
      "html": "<label class=\"ds-field\"><span>OYUNCU ADI</span><input aria-label=\"Oyuncu adı\" placeholder=\"Adın\" /></label>",
      "css": ".ds-field{display:grid;gap:var(--space-2,8px);font-family:var(--font-ui,system-ui,sans-serif)}.ds-field span{color:var(--color-cyan,#25d9f8);font-family:var(--font-mono,monospace);font-size:.75rem;letter-spacing:.12em}.ds-field input{width:100%;height:48px;padding:0 16px;border:1px solid var(--color-border-strong,#365065);border-radius:var(--radius-sm,4px);background:var(--color-bg,#05080c);color:var(--color-text,#edf7fb);caret-color:var(--color-cyan,#25d9f8);font:inherit;transition:border-color var(--motion-fast,120ms),box-shadow var(--motion-fast,120ms)}.ds-field input:focus{border-color:var(--color-cyan,#25d9f8)}.ds-field input:focus-visible{outline:none;box-shadow:var(--focus-ring,0 0 0 2px #05080c,0 0 0 4px #25d9f8)}.ds-field input[aria-invalid=\"true\"]{border-color:var(--color-danger,#ff5d6c)}"
    },
    {
      "name": "Technical frame",
      "kind": "card",
      "refersTo": "tech-frame",
      "description": "Large clipped structural container; sample padding comes from the lobby.",
      "html": "<section class=\"ds-frame\">NEON KNOCKOUT 3D</section>",
      "css": ".ds-frame{position:relative;padding:18px 26px;color:var(--color-text,#edf7fb);font-family:var(--font-ui,system-ui,sans-serif);border:1px solid var(--color-border-strong,#365065);background:rgb(8 14 20 / .98);box-shadow:0 24px 70px rgb(0 0 0 / .42);clip-path:polygon(14px 0,calc(100% - 14px) 0,100% 14px,100% calc(100% - 14px),calc(100% - 14px) 100%,14px 100%,0 calc(100% - 14px),0 14px)}.ds-frame::before{content:\"\";position:absolute;inset:8px;border:1px solid rgb(54 80 101 / .28);pointer-events:none}"
