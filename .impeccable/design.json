      "css": ".ds-command-amber{background:var(--color-bg-raised,#0a1016);color:var(--color-text,#edf7fb);border:1px solid var(--color-border-strong,#365065);font-family:var(--font-ui,system-ui,sans-serif);cursor:pointer;transition:border-color var(--motion-fast,120ms),color var(--motion-fast,120ms),box-shadow var(--motion-fast,120ms),transform var(--motion-fast,120ms);min-height:48px;min-width:180px;padding:0 18px;border-radius:var(--radius-sm,4px);font-weight:650;letter-spacing:.035em;clip-path:polygon(10px 0,100% 0,100% calc(100% - 10px),calc(100% - 10px) 100%,0 100%,0 10px);border-color:rgb(255 179 71 / .72);box-shadow:inset 0 0 20px rgb(255 179 71 / .07),0 0 18px rgb(255 179 71 / .04)}.ds-command-amber:hover{border-color:var(--color-text-muted,#8da4b4)}.ds-command-amber:focus-visible{outline:none;box-shadow:var(--focus-ring,0 0 0 2px #05080c,0 0 0 4px #25d9f8)}.ds-command-amber:active{transform:translateY(1px)}.ds-command-amber:disabled{opacity:.42;cursor:not-allowed;box-shadow:none;border-color:var(--color-border,#21313f)}"
    },
    {
      "name": "Utility button",
      "kind": "button",
